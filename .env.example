# Copiar a .env para desarrollo local. Valores de ejemplo NO sensibles; cambiar fuera de local.
POSTGRES_USER=terra_link
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=terra_link
POSTGRES_PORT=5440
REDIS_PORT=6379
S3_ACCESS_KEY=terra-link-local
S3_SECRET_KEY=change-me-local-s3
S3_PORT=9000
# Bucket privado de originales importados (P0-009); la API crea el bucket si no existe.
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=terra-link-private
# Perfil GeoJSON (P0-009): límites configurables
# GEOJSON_MAX_BYTES=1048576
# GEOJSON_MAX_POSITIONS=5000
# GEOJSON_MAX_DEPTH=10
# GEOJSON_MAX_COMPONENTS=50
# GEOJSON_MAX_RINGS=50

# API
API_PORT=4000
DATABASE_URL=postgres://terra_link:change-me-local@localhost:5440/terra_link
TEST_DATABASE_URL=postgres://terra_link:change-me-local@localhost:5440/terra_link_test
JWT_SECRET=change-me-local-jwt-secret-at-least-32-chars
JWT_TTL_SECONDS=3600
WEB_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379
# Solo true detrás de un proxy de confianza (si no, X-Forwarded-For es falsificable).
TRUST_PROXY=false
# Límite de intentos de login (fallos por ventana; el bloqueo dura como máximo la ventana).
LOGIN_RL_WINDOW_SECONDS=900
LOGIN_RL_MAX_PER_ACCOUNT_IP=5
LOGIN_RL_MAX_PER_ACCOUNT=20
LOGIN_RL_MAX_PER_IP=50
# Vigencia de invitaciones (mecanismo provisional por enlace), en horas.
INVITATION_TTL_HOURS=72
# Cifrado de identidad de productores (doc 06). Generar claves de 32 bytes en base64, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PII_KEYS=k1:<clave>[,k2:<clave>] · PII_ACTIVE_KEY_ID=clave activa · PII_INDEX_KEY=clave del índice ciego (distinta).
# Perder estas claves hace ilegibles los datos cifrados: respaldarlas fuera del repositorio.
PII_KEYS=
PII_ACTIVE_KEY_ID=k1
PII_INDEX_KEY=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Seed de desarrollo (solo local): crea el SUPER_ADMIN inicial si no existe.
SEED_ADMIN_EMAIL=admin@terralink.local
SEED_ADMIN_PASSWORD=

# Acceso federado OIDC (P1-015 / D-54). Deshabilitado por omisión. Para el ensayo local con Keycloak:
#   docker compose --profile sso up -d keycloak   (exige KEYCLOAK_ADMIN_PASSWORD) y luego SSO_ENABLED=true.
# El emisor es la dirección que ve el navegador; SSO_OIDC_DISCOVERY_URL es la que usa la API (nombre de servicio).
# SSO_ENABLED=false
# KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD=<elige una; no la versiones>
# KEYCLOAK_HOST_PORT=8180
# SSO_OIDC_ISSUER=http://localhost:8180/realms/terra-link-dev
# SSO_OIDC_DISCOVERY_URL=http://keycloak:8080/realms/terra-link-dev
# SSO_OIDC_CLIENT_ID=terra-link-web
# SSO_REDIRECT_URIS=http://localhost:3000/acceso/sso

# Puerto del servicio local de cartografía (A-01). Datos: node infra/maps/preparar-mapa.mjs
MAPS_HOST_PORT=8090

# --- EUDR-IS / TRACES NT (P1-007) ---
# Credenciales del servicio web (perfil EU Login → Web Services Access). SE DEJAN VACÍAS: complétalas solo en tu .env local; nunca se versionan ni se envían al chat.
# Se cargan cifradas con: npm run eudr-is:cargar -w apps/api -- --org <uuid-de-la-organización> --env ACCEPTANCE
# Las de un entorno no se reutilizan para el otro. Registrarlas NO activa llamadas: eso depende de EUDR_IS_LIVE_CALLS=enabled.
# Echo (comprobación de conexión) está documentado solo para ACCEPTANCE.
EUDR_IS_LIVE_CALLS=
EUDR_IS_ACCEPTANCE_USERNAME=
EUDR_IS_ACCEPTANCE_AUTH_KEY=
EUDR_IS_ACCEPTANCE_CLIENT_ID=
EUDR_IS_PRODUCTION_USERNAME=
EUDR_IS_PRODUCTION_AUTH_KEY=
EUDR_IS_PRODUCTION_CLIENT_ID=
