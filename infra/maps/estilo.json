    { "id": "cobertura-pasto", "type": "fill", "source": "osm", "source-layer": "landcover", "filter": ["==", "class", "grass"], "paint": { "fill-color": "#d5e6b8" } },
    { "id": "cobertura-cultivo", "type": "fill", "source": "osm", "source-layer": "landcover", "filter": ["==", "class", "farmland"], "paint": { "fill-color": "#e8e8c4" } },
    { "id": "cobertura-humedal", "type": "fill", "source": "osm", "source-layer": "landcover", "filter": ["==", "class", "wetland"], "paint": { "fill-color": "#cfe3d3" } },
    { "id": "cobertura-arena", "type": "fill", "source": "osm", "source-layer": "landcover", "filter": ["in", "class", "sand", "rock"], "paint": { "fill-color": "#ece3c8" } },
