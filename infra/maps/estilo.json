    { "id": "via-secundaria", "type": "line", "source": "osm", "source-layer": "transportation", "filter": ["==", "class", "secondary"], "paint": { "line-color": "#f9d98a", "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.8, 16, 9] } },
