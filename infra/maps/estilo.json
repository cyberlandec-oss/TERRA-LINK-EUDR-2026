    { "id": "nombre-lugar-menor", "type": "symbol", "source": "osm", "source-layer": "place", "filter": ["in", "class", "village", "suburb", "hamlet", "neighbourhood"], "minzoom": 11, "layout": { "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 11 }, "paint": { "text-color": "#3d3d3d", "text-halo-color": "#ffffff", "text-halo-width": 1.2 } },
