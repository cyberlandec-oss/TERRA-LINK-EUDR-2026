{
  "realm": "terra-link-dev",
  "enabled": true,
  "displayName": "Terra Link (ensayo local)",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "none",
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "terra-link-web",
      "name": "Terra Link web (ensayo local)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/acceso/sso",
        "http://localhost:3100/acceso/sso"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/##http://localhost:3100/",
        "use.refresh.tokens": "false"
      },
      "defaultClientScopes": ["openid", "email", "profile"],
      "optionalClientScopes": []
    }
  ]
}
