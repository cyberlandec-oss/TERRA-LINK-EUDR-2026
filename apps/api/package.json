{
  "name": "@terra-link/api",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"const f=require('fs');f.mkdirSync('dist/extraction',{recursive:true});f.copyFileSync('src/extraction/pdf-subproceso.mjs','dist/extraction/pdf-subproceso.mjs')\"",
    "dev": "tsc -p tsconfig.build.json && node -e \"const f=require('fs');f.mkdirSync('dist/extraction',{recursive:true});f.copyFileSync('src/extraction/pdf-subproceso.mjs','dist/extraction/pdf-subproceso.mjs')\" && node --env-file-if-exists=../../.env dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "worker": "tsc -p tsconfig.build.json && node -e \"const f=require('fs');f.mkdirSync('dist/extraction',{recursive:true});f.copyFileSync('src/extraction/pdf-subproceso.mjs','dist/extraction/pdf-subproceso.mjs')\" && node --env-file-if-exists=../../.env dist/worker-main.js",
    "migrate": "tsc -p tsconfig.build.json && node -e \"const f=require('fs');f.mkdirSync('dist/extraction',{recursive:true});f.copyFileSync('src/extraction/pdf-subproceso.mjs','dist/extraction/pdf-subproceso.mjs')\" && node --env-file-if-exists=../../.env dist/db/migrate-cli.js",
    "eudr-is:cargar": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/eudr-is/cargar-credenciales.js",
    "seed:dev": "tsc -p tsconfig.build.json && node -e \"const f=require('fs');f.mkdirSync('dist/extraction',{recursive:true});f.copyFileSync('src/extraction/pdf-subproceso.mjs','dist/extraction/pdf-subproceso.mjs')\" && node --env-file-if-exists=../../.env dist/db/seed-dev.js",
    "seed:demo": "tsc -p tsconfig.build.json && node -e \"const f=require('fs');f.mkdirSync('dist/extraction',{recursive:true});f.copyFileSync('src/extraction/pdf-subproceso.mjs','dist/extraction/pdf-subproceso.mjs')\" && node --env-file-if-exists=../../.env dist/db/seed-demo.js",
    "rekey:pii": "tsc -p tsconfig.build.json && node -e \"const f=require('fs');f.mkdirSync('dist/extraction',{recursive:true});f.copyFileSync('src/extraction/pdf-subproceso.mjs','dist/extraction/pdf-subproceso.mjs')\" && node --env-file-if-exists=../../.env dist/db/rekey-pii.js",
    "openapi": "tsc -p tsconfig.build.json && node -e \"const f=require('fs');f.mkdirSync('dist/extraction',{recursive:true});f.copyFileSync('src/extraction/pdf-subproceso.mjs','dist/extraction/pdf-subproceso.mjs')\" && node --env-file-if-exists=../../.env dist/openapi-export.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test --max-warnings 0",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.17",
    "multer": "^2.4.0",
    "openid-client": "^5.7.1",
    "pdfjs-dist": "4.10.38",
    "pg": "^8.23.1",
    "prom-client": "15.1.3",
    "qrcode-generator": "1.4.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "jsqr": "1.4.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
